# Required. 32-byte hex; encrypts keyset private keys. Generate with: openssl rand -hex 32
# Losing it makes existing events' tickets unverifiable. Back it up separately from the database.
KAMEN_MASTER_KEY=

# Domain served by Caddy (automatic HTTPS for real domains). "localhost" for a local trial.
KAMEN_DOMAIN=localhost

# Public origin used to check NIP-98 signatures, e.g. https://kamen.example
PUBLIC_ORIGIN=

# Proof-of-work difficulty (leading zero bits) for free tickets. 18 ≈ under a second on phones.
POW_DIFFICULTY=18

# Event rooms (Marmot encrypted chat). Space-separated relay URLs; leave empty to disable rooms.
# Attendees' browsers connect to these relays
# directly (relays see their IP). The room agent can read rooms (docs/PRIVACY.md).
ROOM_RELAYS="wss://relay.damus.io wss://nos.lol wss://relay.primal.net"
