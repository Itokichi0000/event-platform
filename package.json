{
  "name": "kamen",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "e2e:docker": "playwright test -c playwright.docker.config.ts e2e/checkin.spec.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@kamen/core": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "nostr-tools": "2.26.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.0.5"
  }
}
